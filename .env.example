# Copy to .env and fill in. Never commit the real file.
# Generate a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

FLASK_ENV=production
SECRET_KEY=replace-me-with-a-48-byte-token

# Workers: 2 x CPU cores + 1 is a good starting point.
WEB_CONCURRENCY=4

# 127.0.0.1:8000 when nginx is in front, 0.0.0.0:8000 when it is not.
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_LOGLEVEL=info

# One trusted proxy hop (nginx).
FORWARDED_ALLOW_IPS=127.0.0.1
TRUST_PROXY=1
