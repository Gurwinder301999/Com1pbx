{
  "name": "comone-hardware-appliance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "build:ui": "node scripts/build-react-ui.js",
    "build:icons": "node scripts/build-favicons.js",
    "build:assets": "npm run build:ui && npm run build:icons && npm run build:images",
    "predev": "npm run build:assets",
    "prebuild": "npm run build:assets",
    "pretest": "npm run build:assets",
    "build:images": "node scripts/build-responsive-images.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1"
  }
}
